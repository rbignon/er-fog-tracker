# Database
DATABASE_URL=postgresql+asyncpg://fogtracker:fogtracker@localhost:5432/fogtracker

# Twitch OAuth
# Create an app at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your_client_id
TWITCH_CLIENT_SECRET=your_client_secret
TWITCH_REDIRECT_URI=http://localhost:8001/auth/twitch/callback

# Server
SECRET_KEY=change-me-to-a-random-secret-key
CORS_ORIGINS=["http://localhost:8001"]

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
# LOG_FILE=/path/to/fogtracker.log
# LOG_FILE_JSON=true

# Data files (fog randomizer zone data)
# DATA_DIR=data

# Directory to store uploaded mod logs (reports)
# REPORTS_DIR=/path/to/reports

# Limits
MAX_GAMES_PER_USER=10
MAX_VIEWERS_PER_GAME=10

# WebSocket
HEARTBEAT_INTERVAL=15
HEARTBEAT_TIMEOUT=10

# Discord integration (optional)
# Send a notification when a player connects their mod
# Create a webhook at: Discord Server Settings > Integrations > Webhooks
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Base URL for external links (used in Discord notifications)
# BASE_URL=https://fogtracker.malenia.win
